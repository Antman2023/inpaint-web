{
  "name": "inpaint-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@heroicons/react": "^1.0.6",
    "localforage": "^1.10.0",
    "opencv-ts": "^1.3.6",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "lint": "biome lint src vite.config.ts",
    "serve": "vite preview",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,css,sass,scss,md}": [
      "prettier --write",
      "echo '统一格式化完成🌸'"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@webgpu/types": "^0.1.71",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "onnxruntime-web": "1.16.3",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
