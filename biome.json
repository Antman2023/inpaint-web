{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!dist",
      "!!build",
      "!!coverage",
      "!!test-results",
      "!!playwright-report",
      "!!media",
      "!!model",
      "!!cache"
    ]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  }
}
